  m_Script: {fileID: 11500000, guid: e8c8a6f8aca7d6d41a2d71ecc9da860f, type: 3}
  m_Name: MaskDudeHola
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  lineas:
  - quien: {fileID: 11400000, guid: 89f16005d2a2914468713ec93d2dd2c5, type: 2}
    texto: "\xA1Hola, rana! Hace d\xEDas que nadie pasa por aqu\xED."
  - quien: {fileID: 11400000, guid: e64aada5d30ef6e41ba2491a9e2b5f25, type: 2}
    texto: "Vengo buscando frutas. \xBFViste alguna?"
  - quien: {fileID: 11400000, guid: 89f16005d2a2914468713ec93d2dd2c5, type: 2}
    texto: "Dicen que m\xE1s all\xE1 del bosque hay frutas que brillan de noche."
  - quien: {fileID: 11400000, guid: e64aada5d30ef6e41ba2491a9e2b5f25, type: 2}
    texto: "\xA1Gracias! Si encuentro una, te guardo un pedacito."
